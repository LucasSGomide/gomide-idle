{
  "name": "@gomide/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "depcruise": "pnpm --filter @gomide/contracts build && depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx ./scripts/migrate.ts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration",
    "generate:openapi": "node --import tsx ./scripts/generate-openapi.ts",
    "generate": "pnpm generate:openapi"
  },
  "dependencies": {
    "@gomide/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/observe": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/websockets": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "nestjs-zod": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@nestjs/testing": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "catalog:",
    "jest": "catalog:",
    "socket.io-client": "catalog:",
    "testcontainers": "catalog:",
    "ts-jest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
