{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vite.config.ts",
    "orval.config.ts",
    "vitest.setup.ts",
    "testing-matchers.d.ts"
  ],
  "exclude": ["dist", "node_modules", "test/fixtures"]
}
