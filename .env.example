# Every variable apps/api/src/config/env.ts declares. Committed with no real
# values (FR.14.2); copy to .env for local development. .env and every other
# env file are git-ignored — only this example is tracked.

# Required, no default. One of: development | test | production
NODE_ENV=development

# Postgres connection string. Required.
DATABASE_URL=postgres://gomide:gomide@localhost:5432/gomide

# The running build's identifier (a git sha in CI). Defaults to 'dev' locally.
BUILD_ID=dev

# HTTP listener. Defaults: 3000 / 0.0.0.0
PORT=3000
HOST=0.0.0.0

# pino level. One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Observability agent (stack-api.md rule 43). Leave the key and secret unset in
# development and CI — with no credentials the agent sends nothing at all
# (FR.21.2). Set both to activate it.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=gomide-api
OBSERVE_ENDPOINT=
