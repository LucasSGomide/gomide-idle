# Every variable apps/api/src/config/env.ts declares. Committed with no real
# values (FR.14.2); copy to .env for local development. .env and every other
# env file are git-ignored — only this example is tracked.

# Required, no default. One of: development | test | production
NODE_ENV=development

# HTTP listener. Defaults: 3000 / 0.0.0.0
PORT=3000
HOST=0.0.0.0

# pino level. One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
