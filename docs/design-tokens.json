{
  "$schema": "gomide_idle meta-UI design tokens — single dark theme, no light variant. See docs/design.md for the reasoning behind each value.",
  "color": {
    "neutral": {
      "bg": "#0B0A10",
      "surface": "#15131C",
      "surfaceElevated": "#1E1B28",
      "surfaceHover": "#1C1926",
      "borderSubtle": "#2A2735",
      "borderStrong": "#6E6484",
      "textPrimary": "#E8E6EF",
      "textSecondary": "#9691A8",
      "textDisabled": "#5F5A70",
      "overlay": "rgba(11, 10, 16, 0.72)"
    },
    "accent": {
      "default": "#A855F7",
      "hover": "#B968FA",
      "active": "#9333EA",
      "muted": "rgba(168, 85, 247, 0.12)",
      "onAccent": "#0B0A10"
    },
    "semantic": {
      "success": { "default": "#22C55E", "bg": "rgba(34, 197, 94, 0.12)" },
      "warning": { "default": "#F59E0B", "bg": "rgba(245, 158, 11, 0.12)" },
      "danger": { "default": "#EF4444", "bg": "rgba(239, 68, 68, 0.14)" },
      "info": { "default": "#38BDF8", "bg": "rgba(56, 189, 248, 0.12)" }
    },
    "damageType": {
      "physical": "#9CA3AF",
      "fire": "#F97316",
      "electric": "#22D3EE"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "'Rajdhani', 'Segoe UI', sans-serif",
      "body": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "arena": "ArenaNumbers"
    },
    "fontWeight": {
      "displayMedium": 500,
      "displaySemibold": 600,
      "displayBold": 700,
      "bodyRegular": 400,
      "bodyMedium": 500,
      "bodySemibold": 600,
      "bodyBold": 700
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "lineHeight": {
      "tight": 1.15,
      "snug": 1.25,
      "normal": 1.5,
      "ui": 1.4
    },
    "letterSpacing": {
      "normal": "0em",
      "heading": "0.01em",
      "uppercaseLabel": "0.08em"
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.75rem",
    "full": "9999px"
  },
  "size": {
    "touchTargetMin": "2.75rem"
  },
  "motion": {
    "duration": {
      "instant": "100ms",
      "fast": "150ms",
      "base": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "reducedMotion": {
      "duration": "1ms",
      "note": "Under prefers-reduced-motion, collapse all transform/scale/position transitions to duration.reducedMotion.duration; keep opacity-only fades at duration.fast so state changes are still perceivable."
    }
  }
}
